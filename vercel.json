{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/scam-report.js": {
      "maxDuration": 15
    },
    "api/roast-report.js": {
      "maxDuration": 30
    }
  }
}
