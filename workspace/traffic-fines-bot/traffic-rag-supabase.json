{
  "name": "Traffic Fines RAG Bot",
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [{"name": "user_query"}]
        }
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-300, 0],
      "id": "trigger",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.user_query }}",
        "options": {
          "systemMessage": "You are an expert on Azerbaijan traffic fines and violations based on the official document 'Cərimə və Ballar Cədvəli' (Fines and Points Table).\n\nRULES:\n1. ALWAYS cite the exact article number as 'Maddə XXX.X' in your response\n2. Reply in the SAME language as the question (Azerbaijani or English)\n3. Be CONCISE - give direct answers with specific fines in AZN and penalty points (bal)\n4. If asked about a violation, provide: article number, fine amount, penalty points\n5. If asked about an article number, provide: what violation it covers, fine amount, penalty points\n6. Use ONLY information from the retrieved documents - don't make up data\n7. If the information is not in the documents, say so\n\nFormat fines clearly: X AZN, Y bal (points)"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [100, 0],
      "id": "ai-agent",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [0, 200],
      "id": "openai-model",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "23mseFmTKiVo6pxW",
          "name": "OpenAi account 2"
        }
      }
    },
    {
      "parameters": {
        "mode": "retrieve",
        "tableName": "documents",
        "topK": 5,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1,
      "position": [200, 200],
      "id": "supabase-retriever",
      "name": "Supabase Vector Store",
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CRED_ID",
          "name": "Supabase Traffic Fines"
        }
      }
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [300, 300],
      "id": "embeddings",
      "name": "OpenAI Embeddings",
      "credentials": {
        "openAiApi": {
          "id": "23mseFmTKiVo6pxW",
          "name": "OpenAi account 2"
        }
      }
    },
    {
      "parameters": {
        "name": "traffic_fines_knowledge",
        "description": "Search the Azerbaijan traffic fines database. Use this for any question about traffic violations, fines, penalties, or specific article numbers (Maddə). Returns relevant sections from the official document."
      },
      "type": "@n8n/n8n-nodes-langchain.toolVectorStore",
      "typeVersion": 1,
      "position": [200, 200],
      "id": "vector-tool",
      "name": "Vector Store Tool"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nreturn { json: { response: input.output || 'No information found.' } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [350, 0],
      "id": "return-response",
      "name": "Return Response"
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [[{"node": "AI Agent", "type": "main", "index": 0}]]
    },
    "AI Agent": {
      "main": [[{"node": "Return Response", "type": "main", "index": 0}]]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [[{"node": "AI Agent", "type": "ai_languageModel", "index": 0}]]
    },
    "Vector Store Tool": {
      "ai_tool": [[{"node": "AI Agent", "type": "ai_tool", "index": 0}]]
    },
    "Supabase Vector Store": {
      "ai_vectorStore": [[{"node": "Vector Store Tool", "type": "ai_vectorStore", "index": 0}]]
    },
    "OpenAI Embeddings": {
      "ai_embedding": [[{"node": "Supabase Vector Store", "type": "ai_embedding", "index": 0}]]
    }
  }
}
